{
  "name": "aether",
  "private": true,
  "version": "1.0.0",
  "description": "Aether — Intelligent Study & Productivity Desktop Workspace",
  "author": "Aether Team",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,server -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:desktop": "concurrently -n vite,electron -c blue,yellow \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start:server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"fs.copyFileSync('electron/preload.cjs', 'dist-electron/preload.cjs')\"",
    "build:desktop": "npm run build && npm run build:electron",
    "package": "rimraf dist-installer && npm run build:desktop && npx electron-packager . Aether --platform=win32 --arch=x64 --out=dist-installer --overwrite",
    "dist": "rimraf dist-desktop dist-installer && npm run build:desktop && npx electron-packager . Aether --platform=win32 --arch=x64 --out=dist-installer --overwrite && npx electron-builder --prepackaged dist-installer/Aether-win32-x64 --win nsis",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "express": "^5.2.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.aether.studyapp",
    "productName": "Aether",
    "copyright": "Copyright © 2026 Aether",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Aether Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aether"
    }
  }
}
